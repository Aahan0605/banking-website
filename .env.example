# AB Pay — every setting is optional; the app runs with none of them set.
# Copy to .env and fill in only what you need.

# Port the server listens on.
PORT=3000

# Where the SQLite file lives.
DB_FILE=./abpay.db

# Session signing key. Generated into .session-secret when unset.
# SESSION_SECRET=

# Enables the Claude-backed assistant. Without it, Abhi answers from a
# deterministic offline engine using the same account snapshot.
# ANTHROPIC_API_KEY=

# Where notifications are delivered. Without it they are written to the log.
# NOTIFY_WEBHOOK=

# The ONLY setting that moves real money.
#
# A UPI ID is usually a phone number, so it is never committed. Set it and the
# public pay page collects genuine payments; leave it unset and that page says
# plainly it is a placeholder.
# RECEIVE_UPI_ID=yourname@okhdfcbank
# RECEIVE_UPI_NAME=YOUR NAME
# RECEIVE_UPI_BANK=Your Bank
